{
    "name": "markc/spe",
    "description": "Simple PHP Engine (SPE)",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark Constable",
            "email": "mc@netserva.org"
        }
    ],
    "require": {
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "SPE\\App\\": "app/lib",
            "SPE\\Autoload\\": "05-Autoload/src",
            "SPE\\Session\\": "06-Session/src",
            "SPE\\PDO\\": "07-PDO/src",
            "SPE\\Auth\\": "08-Auth/src",
            "SPE\\Blog\\": "09-Blog/src"
        }
    },
    "minimum-stability": "stable",
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "require-dev": {
        "pestphp/pest": "*",
        "carthage-software/mago": "*"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "carthage-software/mago": true
        }
    },
    "scripts": {
        "lint": "mago lint --semantics",
        "lint:all": "mago lint",
        "format": "mago format",
        "test": "pest",
        "check": [
            "php bin/check-chapters.php",
            "@lint",
            "@test"
        ],
        "fix": "@format"
    }
}
